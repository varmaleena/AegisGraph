FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
OPENAI_API_KEY=
CORS_ORIGINS=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000
# V2 model-directed MCP. Use your account's supported tool-calling model.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
GROQ_API_KEY=
# For Groq set LLM_PROVIDER=groq and LLM_MODEL=openai/gpt-oss-120b

# Optional Gemini routes (same-project keys share quota)
GEMINI_API_KEYS=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
LLM_SELECTION_TIMEOUT_SECONDS=90
